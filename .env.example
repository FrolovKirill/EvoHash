# OpenRouter API key — get one at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-...

# Optional: pin a specific model instead of using the ensemble
# OPENROUTER_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Weights & Biases — get key at https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=evohash

# ── Efficiency metric configuration ─────────────────────────────────────────
# Mode: weighted_sum | harmonic | geometric | l2_only | lpips_only
EFFICIENCY_MODE=weighted_sum
# Weights (used by weighted_sum, harmonic, geometric modes)
EFFICIENCY_L2_WEIGHT=1.0
EFFICIENCY_LPIPS_WEIGHT=50.0
